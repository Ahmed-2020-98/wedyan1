APP_NAME="وديان — لوحات فنية"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8300

# المنصة عربية بالكامل. التاريخ ميلادي والأرقام لاتينية — انظر docs/WORKFLOWS.md
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# 8889 = خادم MAMP
# إن كنت تستخدم MySQL من Homebrew غيّرها إلى 3306 واضبط كلمة المرور
DB_PORT=8889
DB_DATABASE=wedyan_art
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# الملفات العامة (صور اللوحات) على قرص public. للانتقال إلى S3 لاحقاً
# يكفي تغيير هذه القيمة إلى s3 دون تعديل أي سطر برمجي — انظر ImageService.
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@wedyan.local"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# عناوين الواجهات — تُستخدم في روابط التحقق من البريد وإعادة تعيين
# كلمة المرور وإعادة التوجيه بعد الدفع.
# ------------------------------------------------------------------
WEB_URL=http://localhost:4200
ADMIN_URL=http://localhost:4300
SANCTUM_STATEFUL_DOMAINS=localhost:4200,localhost:4300
FRONTEND_URLS=http://localhost:4200,http://localhost:4300

# ------------------------------------------------------------------
# بوابة الدفع
# ------------------------------------------------------------------
# اخترنا Paymob لأنها تغطي السعودية ومصر معاً وتدعم مدى وآبل باي
# والبطاقات العالمية، وتوفّر صفحة دفع مستضافة (Unified Checkout) تُبقي
# المنصة خارج نطاق PCI-DSS — فلا تمرّ بيانات البطاقة بخوادمنا أصلاً.
#
# driver=fake هو الافتراضي، فيعمل المشروع كاملاً بلا أي حساب.
PAYMENT_GATEWAY=fake

# ksa → https://ksa.paymob.com (SAR)  |  egypt → https://accept.paymob.com (EGP)
PAYMOB_REGION=ksa
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
# معرّفات طرق الدفع من لوحة Paymob، مفصولة بفواصل
PAYMOB_INTEGRATION_IDS=

# ------------------------------------------------------------------
# الضريبة والشحن (قيم افتراضية — يمكن تعديلها من لوحة الإدارة)
# ------------------------------------------------------------------
TAX_ENABLED=true
TAX_PERCENTAGE=15
DEFAULT_CURRENCY=SAR
# التخزين بتوقيت UTC دائماً؛ هذه لغرض العرض فقط في الواجهة والتقارير.
DISPLAY_TIMEZONE=Asia/Riyadh
